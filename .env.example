# Copy values into Horizon's secret environment settings, never GitHub.
PLAUD_TOKENS_JSON=
# Recommended for Horizon: private Redis with TLS, to persist rotated tokens.
PLAUD_REDIS_URL=
PLAUD_REDIS_KEY=plaudcli:tokens
PLAUD_TIMEZONE=Asia/Shanghai
# Local-only alternative to Redis:
# PLAUD_TOKEN_FILE=/absolute/private/path/tokens.json
# Optional regional overrides, matching the official CLI:
# PLAUD_API_BASE=https://platform.plaud.ai/developer/api
# PLAUD_REFRESH_URL=https://platform.plaud.ai/developer/api/oauth/third-party/access-token/refresh
# PLAUD_REGION=
# Optional comma-separated allowed suffixes for signed transcript/notes hosts:
# PLAUD_DATA_LINK_ALLOWED_HOSTS=
